# Copie ce fichier en .env et remplis les valeurs.
# En production (Railway/Render), ajoute ces variables dans le dashboard.

# Serveur
PORT=3001

# Auth (obligatoire) — JWT pour inscription / connexion / session ; min. 32 caractères.
# Sans JWT_SECRET, l’inscription renvoie une erreur 500 en local. Génère une chaîne longue et garde-la privée.
# JWT_SECRET=remplace-par-une-chaine-aleatoire-d-au-moins-32-caracteres
#
# PassKit / signature des passes (obligatoire en prod ; requis dès que tu génères un .pkpass en local).
# PASSKIT_SECRET=autre-chaine-aleatoire-d-au-moins-32-caracteres

# Apple Wallet (obligatoire pour générer les passes)
PASS_TYPE_ID=pass.com.fidelity
TEAM_ID=ton_team_id_apple
ORGANIZATION_NAME=Carte fidelite

# URL publique de l’API (sans slash final), ex. https://api.myfidpass.fr
# Utilisée pour OAuth Google, liens absolus, etc. — doit être identique à l’URL réelle Railway / DNS.
# Si tu ne la définis pas, le serveur tente de deviner depuis les en-têtes (moins fiable derrière certains proxies).
# API_URL=https://api.myfidpass.fr

# Retour OAuth (Meta / YouTube / TikTok) : Universal Link sur le site (Vercel) puis redirection myfidpass://
# Google Business : toujours 302 direct myfidpass:// (ignoré si MYFIDPASS_OAUTH_RETURN_BASE est défini — sauf ce flux).
# Pages : https://myfidpass.fr/oauth/tiktok | meta | google-youtube (+ apple-app-site-association)
# Vide = repli direct myfidpass://oauth-… (sans UL).
# MYFIDPASS_OAUTH_RETURN_BASE=https://myfidpass.fr/oauth

# URL du backend (obligatoire pour que l'iPhone s'enregistre et reçoive les notifications)
# Sans cette variable, le pass ne contient pas l'URL d'enregistrement → "Aucun appareil enregistré".
# Mettre l'URL publique de ton API (sans slash final), ex. https://api.myfidpass.fr
PASSKIT_WEB_SERVICE_URL=https://api.myfidpass.fr

# CORS : URL du site en production
FRONTEND_URL=https://myfidpass.fr

# Tests uniquement : affiche le bouton dashboard « effacer tous les tickets livraison » + POST .../delivery-receipt-claims/dev-reset
# Ne pas activer en production (risque de purge des réclamations / annulation des crédits).
# DELIVERY_RECEIPT_DEV_RESET=1

# Stripe — abonnement (Payment Element /abonnement + webhooks)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Prix mensuel 49,99 €/mois (rétrocompat : STRIPE_PRICE_ID_STARTER = alias du mensuel)
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_STARTER=price_...
# Facturation annuelle 399,00 €/an — obligatoire dès qu’un utilisateur choisit « Annuel » (/paiement, /abonnement).
# Création dans Stripe Dashboard :
#   Produits → ouvrir le même produit que le mensuel (recommandé) → « Ajouter un autre prix »
#   → Récurrent → Facturation « Par an » → montant 399,00 EUR → Enregistrer → copier l’ID price_…
# Railway (ou .env local) : ajouter la variable ci-dessous puis redémarrer le service API.
# STRIPE_PRICE_ID_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Jours d’essai Stripe (défaut 0 — offre 1er mois à 1 € via coupon). Mensuel intégré : facture immédiate à 1 €.
# STRIPE_SUBSCRIPTION_TRIAL_DAYS=0
# Essai dédié à l’offre **annuelle** (jours). Laisser à 0 pour facturer 1 € puis 399 €/an via coupon.
# STRIPE_SUBSCRIPTION_TRIAL_DAYS_ANNUAL=0
# Coupon « once » : 1er prélèvement à 1,00 € sur le **mensuel** 49,99 € (remise fixe 48,99 €)
# STRIPE_COUPON_ID_FIRST_MONTH_1_EUR=jTX...
# Coupon « once » : 1ère facture à 1,00 € sur l’**annuel** 399,00 €/an (remise fixe 398,00 €) — créer un coupon dédié dans Stripe
# STRIPE_COUPON_ID_ANNUAL_FIRST_1_EUR=...
# Webhook Railway : au minimum customer.subscription.*, invoice.paid, setup_intent (synchro abonnement intégré).

# Frontend Vercel — clé publique pour Stripe.js (Payment Element / Apple Pay / Google Pay sur /abonnement)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Optionnel — test : rediriger /abonnement vers un Payment Link au lieu du formulaire intégré
# VITE_STRIPE_SUBSCRIPTION_PAYMENT_LINK=https://buy.stripe.com/...
# Optionnel — code promo client prérempli (ex. coupon « une fois » pour 1er mois à 1 €)
# VITE_STRIPE_SUBSCRIPTION_PREFILLED_PROMO=MYFID1EURO

# Stripe — pack « créations flyer » (paiement unique, crédite flyer_ai_generations_bonus)
# Crée un prix « one-time » sur le produit Stripe, copie l’ID price_… ici.
# STRIPE_PRICE_ID_FLYER_PACK=price_...
# Optionnel : nombre de générations par achat (défaut 25). Aligner sur le libellé produit.
# FLYER_PACK_GENERATIONS=25

# Flyer IA — optionnel : remplace le secret par défaut codé en dur pour .../flyer/ai-dev-unlock (≥ 8 caractères).
# FLYER_AI_DEV_UNLOCK_SECRET=
# Slugs toujours illimités (tests, séparés par virgule).
# FLYER_AI_UNLIMITED_SLUGS=mon-commerce-demo

# Optionnel : si ta clé certificat Apple est protégée par mot de passe
# SIGNER_KEY_PASSPHRASE=ton_mot_de_passe

# Certificats Apple Wallet (au choix) :
# 1) Fichiers dans backend/certs/ : wwdr.pem, signerCert.pem, signerKey.pem
# 2) Variables (recommandé en prod) : WWDR_PEM, SIGNER_CERT_PEM, SIGNER_KEY_PEM
#    = contenu complet de chaque fichier .pem (copier-coller). Voir docs/APPLE-WALLET-SETUP.md

# Google Places (optionnel — pour la suggestion de couleurs depuis la photo du lieu)
# Même clé que sur Vercel (VITE_GOOGLE_PLACES_API_KEY) ou une clé serveur.
# GOOGLE_PLACES_API_KEY=AIza...

# OAuth « Fiche Google » avis en direct (Google Business Profile) : réutilise GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET.
# Redirect URI à ajouter dans Google Cloud : https://<API_URL>/api/oauth/google-business/callback
# APIs à activer sur le projet : Google Business Profile API, Business Information API, My Business Account Management API.
# Retour app : 302 direct myfidpass://oauth-google-business (évite chargement infini dans ASWebAuthenticationSession).

# Google Wallet (optionnel — pour les utilisateurs Android)
# Voir docs/GOOGLE-WALLET-SETUP.md
# GOOGLE_WALLET_ISSUER_ID=33880000000123456789
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...","client_email":"...@....iam.gserviceaccount.com",...}

# Notifications push (production) — obligatoire pour que les notifications restent actives après redémarrage.
# Générer une fois : npm run generate-vapid-keys (dans backend/)
# Puis ajouter les deux valeurs dans Railway (Variables du service backend).
# VAPID_PUBLIC_KEY=BDcrXOd-Cs3S1yVlCCHv7O7aXXAtZ7APYrw4rfSIsmyZB-6EZzsT8zxTPdr19Gy40lCj_79F9RF2Aj5jvwdjNZ4
# VAPID_PRIVATE_KEY=<copier la clé privée affichée par npm run generate-vapid-keys>

# Connexion Google et Apple (optionnel — affiche les boutons « Continuer avec Google » et « Apple »)
# Créer un projet Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
# Pour Apple : Developer → Certificates, IDs & Profiles → Identifiers → Services ID.
# Même valeur côté frontend (Vercel) : VITE_GOOGLE_CLIENT_ID et VITE_APPLE_CLIENT_ID.
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.ton.domaine.service (Services ID Apple)
# APPLE_BUNDLE_ID=com.myfidpass (bundle iOS — validation IAP StoreKit)

# App Store — abonnements in-app (StoreKit 2, app iOS commerçant)
# App Store Connect → Users and Access → Integrations → In-App Purchase → générer une clé API (.p8)
# APP_STORE_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APP_STORE_KEY_ID=XXXXXXXXXX
# APP_STORE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APP_STORE_ENVIRONMENT=production
# Identifiants produits (doivent correspondre à App Store Connect) :
# APPLE_IAP_PRODUCT_ID_MONTHLY=MFPmensuel
# APPLE_IAP_PRODUCT_ID_ANNUAL=MFPannuel
# Code offre custom App Store (secours iOS, même libellé que Stripe MYFID1EURO) — à créer dans App Store Connect → Offres → Codes.
# APPLE_IAP_CUSTOM_OFFER_CODE=MYFID1EURO

# Optionnel : active POST /api/dev/reset (bouton « Réinitialiser toutes les données » sur le site).
# En production (Railway), n’importe quelle chaîne ; retirer la variable après usage.
# RESET_SECRET=ton_mot_de_passe

# Compte démo App Store Review — POST /api/auth/ensure-demo (créé/réinitialisé par curl après chaque déploiement).
# Sans cette variable, le secret par défaut est utilisé (voir auth.js → ensure-demo).
# DEMO_SECRET=myfidpass-appstore-review-2026

# Mot de passe oublié : envoi d’email (obligatoire en prod pour recevoir le lien).
# Voir docs/EMAIL-TRANSACTIONNEL.md
#
# Option A — Resend (recommandé). Voir docs/EMAIL-TRANSACTIONNEL.md (onboarding vs domaine vérifié).
# RESEND_API_KEY=re_xxxxxxxx
# Sans MAIL_FROM ni RESEND_FROM : expéditeur par défaut onboarding@resend.dev (limites Resend sur les destinataires).
# Après vérif DNS du domaine sur resend.com/domains :
# RESEND_FROM=Myfidpass <noreply@myfidpass.fr>
# ou MAIL_FROM=Myfidpass <noreply@myfidpass.fr>
#
# Option B — SMTP classique
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=xxx
# MAIL_FROM=noreply@myfidpass.fr
