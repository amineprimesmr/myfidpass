{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [{ "key": "Content-Type", "value": "application/json" }]
    },
    {
      "source": "/.well-known/apple-developer-merchantid-domain-association",
      "headers": [{ "key": "Content-Type", "value": "application/octet-stream" }]
    }
  ],
  "redirects": [
    { "source": "/ios", "destination": "https://apps.apple.com/app/id6759921605", "permanent": true },
    {
      "source": "/confidentialite",
      "destination": "/politique-confidentialite",
      "permanent": true
    },
    {
      "source": "/confidentialité",
      "destination": "/politique-confidentialite",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://api.myfidpass.fr/api/$1" },
    { "source": "/oauth/tiktok", "destination": "/oauth/tiktok.html" },
    { "source": "/oauth/meta", "destination": "/oauth/meta.html" },
    { "source": "/oauth/google-youtube", "destination": "/oauth/google-youtube.html" },
    { "source": "/oauth/google-business", "destination": "/oauth/google-business.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
